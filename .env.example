# Required: your Anthropic credentials.
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=sk-ant-...

# Model and research
MODEL=claude-opus-5          # claude-sonnet-5 is cheaper and faster
EFFORT=low                   # low | medium | high | xhigh | max
ENABLE_WEB_SEARCH=1          # ground episodes in live sources
MAX_WEB_SEARCHES=5

# Voice: auto | piper | espeak | debug
TTS_ENGINE=auto
ESPEAK_VOICE=en-us
# PIPER_BIN=piper
# PIPER_MODEL=/voices/en_US-lessac-medium.onnx

# Cold open: a small fast model speaks one framing sentence while the main
# model is still researching, so audio starts almost immediately.
ENABLE_COLD_OPEN=1
COLD_OPEN_MODEL=claude-haiku-4-5
COLD_OPEN_WORDS=18

# Shared script cache: different people asking the same thing reuse one script.
CACHE_ENABLED=1
CACHE_BACKEND=sqlite         # sqlite (shared by all workers) | memory
CACHE_PATH=scripts.db
CACHE_TTL_SECONDS=86400      # default script lifetime
CACHE_TTL_VOLATILE=900       # for "latest"/"today"-style queries
CACHE_SEMANTIC_KEY=0         # 1 = use a small model to match phrasings better
CANONICAL_KEY_MODEL=claude-haiku-4-5

# Pacing
TARGET_WPM=150
MIN_WPM=115
MAX_WPM=185

# Server
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_SECONDS=3
