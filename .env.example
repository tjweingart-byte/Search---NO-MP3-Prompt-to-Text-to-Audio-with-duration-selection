# Required: your Anthropic credentials.
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=sk-ant-...

# HTTP transport. Some proxies and TLS-inspecting middleboxes break HTTP/2 to
# api.anthropic.com, which surfaces only as "Connection error". The client is
# pinned to HTTP/1.1; set to 1 (and `pip install h2`) to opt back into HTTP/2.
ANTHROPIC_HTTP2=0

# Model and research.
#
# These values are the settled defaults, and every one of them is a decision
# about the same thing: audio must start within about a second. Changing them
# is allowed; doing it by accident is what this file used to cause.
MODEL=claude-sonnet-5        # opus is slower to the first sentence
EFFORT=low                   # low | medium | high | xhigh | max
# auto | never | always.
#
# `auto` reads the question. One that names a moving target - "latest",
# "today", "score", "breaking" - is researched and waits for it; everything
# else is answered from what the model already knows, immediately. Search
# front-loads 10-25 seconds before the first word, so `always` pays that on
# every episode including the ones that did not need it.
# A request can still say search=1 or search=0 and win.
SEARCH_MODE=auto
MAX_WEB_SEARCHES=3

# Answer first, research underneath. On an episode that is going to be
# researched, a second call with no tools starts writing immediately; that is
# spoken while the search runs, and the researched half takes over the moment
# it has a sentence ready. Costs one extra model call on researched episodes.
ANSWER_FIRST=1
# The most of an episode the instant half may speak before it must give way.
# Without this ceiling the from-knowledge half can finish the whole episode in
# the time the search takes, and the research never gets said at all.
ANSWER_FIRST_SHARE=0.5
# How far past that ceiling the cover may go when research is STILL not ready.
# The ceiling is about sharing, not a deadline: enforced as a deadline it made
# the cover stop while the search was still reading, and the pipeline then
# blocked on research - silence in the middle of an episode already playing.
# Past the ceiling the cover keeps speaking; this is where that stops. At 0.8
# the researched half still gets a fifth of the episode.
ANSWER_FIRST_MAX_SHARE=0.8

# Which generation pipeline a request runs through: legacy | phase6
#
# legacy is the shipped path - every sentence goes to the voice on its own,
# through a bounded queue that the synthesiser drains.
#
# phase6 is the validated streaming architecture: a character-bounded script
# buffer between the model reader and the voice, so synthesis falling behind
# cannot stop the reader, and speech-sized chunks after the first. The first
# chunk keeps its own latency path - the first complete speakable thought goes
# out immediately, with no word count and no batching delay.
#
# It is NOT wired to anything yet: setting phase6 today changes no behaviour.
# Leave this on legacy. An unrecognised value is refused at startup rather
# than falling back, so a typo cannot quietly pick a pipeline.
STREAMING_PIPELINE=legacy

# How much audio must exist before the response starts, in seconds.
#
# A quantity, not a delay. At TARGET_WPM=150 this is 3.75 words, so any
# ordinary opening sentence satisfies it on the first chunk and it costs
# nothing; it only forces a second synthesis when the opening is very short.
# It exists because models stream in bursts, and because it is the last point
# at which a failed generation can still become an error rather than a silent
# empty episode.
#
# Must be greater than zero: at zero a streamed WAV's 44-byte header alone
# satisfies the gate and every episode is refused as empty.
PREROLL_SECONDS=1.5

# Where voice models live. Defaults to ~/.fam/voices, shared by every version of
# the app, so a new copy of the project does not re-download them.
# FAM_VOICES_DIR=~/.fam/voices

# Development override only. Leave it on auto in any deployment.
#
# Production does not choose a speech engine any more: there is one production
# slot (tts.PRODUCTION_ENGINES), which Chatterbox will fill. `auto` means "the
# production engine, or the interim one while that slot is empty" - and
# /api/health says which of those you are hearing.
#
# The other values name a development engine for deterministic local work:
# espeak | say | debug. None of them is a production voice: espeak and macOS
# `say` exist only if the host OS happens to provide them, which is how a
# deployment ends up sounding worse than the laptop it was built on, and
# `debug` is a tone. Piper used to be listed here as an interim voice and has
# been removed entirely - engine, package and dependency.
TTS_ENGINE=auto

# Chatterbox, FAM's production voice.
#
# Where it runs: auto | cuda | mps. `auto` picks cuda, then mps, and refuses
# cpu - Chatterbox on a CPU is slower than speech, so the episode would starve
# and the listener would hear gaps.
CHATTERBOX_DEVICE=auto
#
# The recording it clones. Blank means reference_3.wav in the shared voice
# folder (~/.fam/voices). It is somebody's voice, so a rights record must sit
# beside it - reference_3.rights.json - clearing consent, commercial_use and
# synthetic_voice_cleared. Without it the engine reports unavailable and
# /api/health says `interim: true` - which now means no voice at all, only a
# placeholder tone. There is no second engine to fall back to.
# CHATTERBOX_REFERENCE=~/.fam/voices/reference_3.wav

ESPEAK_VOICE=en-us

# Shared script cache: different people asking the same thing reuse one script.
CACHE_ENABLED=1
CACHE_BACKEND=sqlite         # sqlite (shared by all workers) | memory
CACHE_PATH=scripts.db
CACHE_TTL_SECONDS=86400      # default script lifetime
CACHE_TTL_VOLATILE=900       # for "latest"/"today"-style queries
CACHE_SEMANTIC_KEY=0         # 1 = use a small model to match phrasings better
CANONICAL_KEY_MODEL=claude-haiku-4-5

# Pacing
TARGET_WPM=150
MIN_WPM=115
MAX_WPM=185

# Server
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_SECONDS=3
