# Copy to .env for local runs. In CI these are repository secrets instead.
# .env is gitignored; none of these values belong in the repository.

# --- App Store Connect API key (Users and Access > Integrations > App Store Connect API)
# Role: App Manager is enough to upload and distribute to TestFlight.
ASC_KEY_ID=ABCD123456
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# The .p8 file, base64'd:  base64 -i AuthKey_ABCD123456.p8 | tr -d '\n'
ASC_KEY_P8=LS0tLS1CRUdJTi...

# --- Apple Developer team
FAM_TEAM_ID=XXXXXXXXXX
FAM_APP_IDENTIFIER=com.fam.app

# --- Where the app points. Release must be the deployed server with a GPU.
FAM_API_BASE_URL_RELEASE=https://api.example.com
FAM_API_BASE_URL_DEBUG=http://192.168.1.10:8000

# --- TestFlight groups
FAM_INTERNAL_GROUP=Internal
FAM_EXTERNAL_GROUP=Public Beta

# --- Beta App Review contact, required only for the `external` lane.
FAM_REVIEW_EMAIL=beta@example.com
FAM_REVIEW_FIRST_NAME=First
FAM_REVIEW_LAST_NAME=Last
FAM_REVIEW_PHONE=+10000000000
FAM_DEMO_USER=review@example.com
FAM_DEMO_PASSWORD=set-a-real-one
