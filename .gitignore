__pycache__/
*.pyc
.env
.venv/
venv/
.pytest_cache/
*.wav

# Voice models: tens of MB each, installed by setup_voices.py
voices/
*.onnx
*.onnx.json

# Runtime state, not source. myfam.db holds listener interaction history and
# was tracked by accident - it churns on every run and should never be shared.
*.db
*.db-wal
*.db-shm
preview/fam-preview.html
preview/fam-artifact.html
attachments.db

# The launcher installs into here; it is per-machine, never committed.
.fam-venv/

# Experiment results: raw trials, reports and generated audio. Kept out of
# git by default so a sweep does not commit itself; promote a run deliberately.
experiments/runs/

# Captured evidence packets: data, not source. Capture your own with
# tools/capture_packet.py so a benchmark is never run against someone
# else's stale evidence.
experiments/packets/*.json

# Measured connection baselines: data, not source.
experiments/baselines/*.json

# The extracted chunk corpus: derived from a preserved run, rebuilt with
# tools/extract_chunks.py. Not source, and machine-specific in provenance.
experiments/chunks/*.json

# Reference recordings for voice cloning: somebody's voice, not source code,
# and covered by whatever rights agreement they came with. The README and the
# rights-record template are tracked; no audio is.
experiments/references/*
!experiments/references/README.md
!experiments/references/example.rights.json
# sources.json maps neutral ids to real recordings, so it is as identifying as
# the audio itself.

# The pod bundle built by tools/pack_for_pod.py: a copy of the tree, not a
# thing to version.
fam-pod.tar.gz
